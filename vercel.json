{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/buscar.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/buscar",
      "dest": "/api/buscar.js",
      "methods": ["POST"]
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
